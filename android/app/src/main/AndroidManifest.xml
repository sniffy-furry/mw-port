<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <!-- Modern Android does not require this permission just to read the
         app's own external-files directory (getExternalFilesDir), which is
         where L2RA.BUN / STREAML2RA.BUN should be copied to after install.
         Kept for older devices / manual copy via a file manager app. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <application
        android:allowBackup="true"
        android:label="NFS MW Port"
        android:hasCode="false">
        <activity
            android:name="android.app.NativeActivity"
            android:label="NFS MW Port"
            android:configChanges="orientation|keyboardHidden|screenSize|uiMode"
            android:screenOrientation="portrait"
            android:exported="true">
            <meta-data android:name="android.app.lib_name" android:value="nfsmw_port" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
